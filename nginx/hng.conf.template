upstream nextcloud_upstream {
  server nextcloud:80;
}

upstream detector_dashboard {
  server host.docker.internal:8081;
}

server {
  listen 80 default_server;
  server_name _;

  access_log /var/log/nginx/hng-access.log hng_json;
  error_log /var/log/nginx/error.log warn;

  location / {
    proxy_pass http://nextcloud_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600;
    proxy_send_timeout 3600;
  }
}

server {
  listen 80;
  server_name ${DASHBOARD_HOST};

  access_log /var/log/nginx/hng-access.log hng_json;
  error_log /var/log/nginx/dashboard-error.log warn;

  location / {
    proxy_pass http://detector_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
